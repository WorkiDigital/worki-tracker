# ═══════════════════════════════════════════
# WORKI TRACKER — Configuração
# ═══════════════════════════════════════════

# Servidor
PORT=3000
NODE_ENV=production

# PostgreSQL (ajuste com os dados do seu EasyPanel)
DATABASE_URL=postgresql://usuario:senha@host:5432/worki_tracker

# Domínios permitidos (CORS) — coloque o domínio da sua landing page
ALLOWED_ORIGINS=https://seusite.com.br,https://www.seusite.com.br

# Chave de API (gere uma aleatória para proteger os endpoints)
API_KEY=sua-chave-secreta-aqui

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://sua-evolution.com
EVOLUTION_API_KEY=sua-api-key-evolution
EVOLUTION_INSTANCE=sua-instancia

# Webhook Secret (opcional, pra validar que o webhook vem da Evolution)
WEBHOOK_SECRET=
